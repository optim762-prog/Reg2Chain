r2c:OilComprisingExclusivelyOilsObtainedByProcessingOlivePomaceAndOilsObtainedDirectlyFromOlives a owl:Class ;
    rdfs:label "‘oil comprising exclusively oils obtained by processing olive pomace and oils obtained directly from olives’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:OilComprisingExclusivelyOilsObtainedByTreatingTheProductObtainedAfterTheExtractionOfOliveOilAndOilsObtainedDirectlyFromOlives a owl:Class ;
    rdfs:label "‘oil comprising exclusively oils obtained by treating the product obtained after the extraction of olive oil and oils obtained directly from olives’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:OilComprisingExclusivelyOliveOilsThatHaveUndergoneRefiningAndOilsObtainedDirectlyFromOlives a owl:Class ;
    rdfs:label "‘oil comprising exclusively olive oils that have undergone refining and oils obtained directly from olives’"@en ;
