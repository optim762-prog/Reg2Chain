    rdfs:subClassOf r2c:LabelItem .

r2c:ProtectedDesignationOfOriginOrAProtectedGeographicalIndication a owl:Class ;
    rdfs:label "protected designation of origin or a protected geographical indication"@en ;
    r2c:refersTo r2c:Ref_RegulationEUNo11512012 ;
