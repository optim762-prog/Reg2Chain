r2c:PercentageOfSuchOilsInTheBlend a owl:Class ;
    rdfs:label "percentage of such oils in the blend"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:PercolationOrCentrifugationOfTheOlivePaste a owl:Class ;
    rdfs:label "percolation or centrifugation of the olive paste"@en ;
    rdfs:subClassOf r2c:Process .

r2c:PeroxideValueMEqO2Kg a owl:Class ;
    rdfs:label "Peroxide value (mEq O2/kg)"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:PrincipalFieldOfVision a owl:Class ;
    rdfs:label "principal field of vision"@en ;
