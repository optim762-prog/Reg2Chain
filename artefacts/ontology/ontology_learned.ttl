r2c:OpeningSystem a owl:Class ;
    rdfs:label "opening system"@en ;
    rdfs:subClassOf r2c:Process .

r2c:PercentageOfAddedOils a owl:Class ;
    rdfs:label "percentage of added oils"@en ;
