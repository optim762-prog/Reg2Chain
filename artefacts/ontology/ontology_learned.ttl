r2c:ListOfIngredients a owl:Class ;
    rdfs:label "list of ingredients"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:Marketing a owl:Class ;
    rdfs:label "marketing"@en ;
    rdfs:subClassOf r2c:Process .

r2c:MarketingOnTheirTerritory a owl:Class ;
    rdfs:label "marketing on their territory"@en ;
    rdfs:subClassOf r2c:Process .

r2c:MedianOfDefectMd a owl:Class ;
    rdfs:label "Median of defect (Md)"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:MemberState a owl:Class ;
    rdfs:label "Member State"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:MemberStateOrTheUnion a owl:Class ;
    rdfs:label "Member State or the Union"@en ;
    rdfs:subClassOf r2c:Union .

r2c:Mill a owl:Class ;
    rdfs:label "mill"@en ;
    rdfs:subClassOf r2c:Actor .

r2c:MillWhereTheOilWasExtractedFromTheOlivesIsSituated a owl:Class ;
    rdfs:label "mill where the oil was extracted from the olives is situated"@en ;
    rdfs:subClassOf r2c:Process .

r2c:MonthOfTheExtractionOfTheOilFromTheOlives a owl:Class ;
    rdfs:label "month of the extraction of the oil from the olives"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:NameOfTheFood a owl:Class ;
    rdfs:label "name of the food"@en ;
