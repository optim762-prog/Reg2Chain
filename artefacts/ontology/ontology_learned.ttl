@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix r2c: <http://example.org/reg2chain/olive-oil#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

r2c:Acidity a owl:Class ;
    rdfs:label "Acidity (%)"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:BlendConcerned a owl:Class ;
    rdfs:label "blend concerned"@en ;
    rdfs:subClassOf r2c:Product .

r2c:BlendOfOliveOilsNotOfEuropeanUnionOrigin a owl:Class ;
    rdfs:label "‘blend of olive oils not of European Union origin’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:BlendOfOliveOilsOfEuropeanUnionOrigin a owl:Class ;
    rdfs:label "‘blend of olive oils of European Union origin’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:BlendOfOliveOilsOfEuropeanUnionOriginAndNotOfEuropeanUnionOrigin a owl:Class ;
    rdfs:label "‘blend of olive oils of European Union origin and not of European Union origin’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:BlendOfVegetableOilsOrTheSpecificNamesOfTheVegetableOilsConcernedAndOliveOil a owl:Class ;
    rdfs:label "‘Blend of vegetable oils (or the specific names of the vegetable oils concerned) and olive oil’"@en ;
    rdfs:subClassOf r2c:OliveOil .

r2c:BlendWithOtherVegetableOils a owl:Class ;
    rdfs:label "blend with other vegetable oils"@en ;
    rdfs:subClassOf r2c:Oils .

r2c:BlendsOfOliveOils a owl:Class ;
    rdfs:label "blends of olive oils"@en ;
    rdfs:subClassOf r2c:OliveOils .

r2c:CategoryOfOil a owl:Class ;
    rdfs:label "category of oil"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:CharacteristicsOfOliveOils a owl:Class ;
    rdfs:label "characteristics of olive oils"@en ;
    r2c:refersTo r2c:Ref_AnnexI,
        r2c:Ref_CommissionImplementingRegulationEU202221 ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:ColdExtraction a owl:Class ;
    rdfs:label "‘cold extraction’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:ConsumptionInRestaurantsHospitalsCanteensAndOtherSimilarCollectiveEstablishments a owl:Class ;
    rdfs:label "consumption in restaurants, hospitals, canteens and other similar collective establishments"@en ;
    rdfs:subClassOf r2c:Process .

r2c:Container a owl:Class ;
    rdfs:label "container"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:DescriptionOfTheOils a owl:Class ;
    rdfs:label "description of the oils"@en ;
