r2c:GeographicalArea a owl:Class ;
    rdfs:label "geographical area"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:HydraulicPresses a owl:Class ;
    rdfs:label "hydraulic presses"@en ;
    rdfs:subClassOf r2c:Process .

r2c:InternalConsumption a owl:Class ;
    rdfs:label "internal consumption"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:K232 a owl:Class ;
    rdfs:label "K232"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:K268OrK270 a owl:Class ;
    rdfs:label "K268 or K270"@en ;
