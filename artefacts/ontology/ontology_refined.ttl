@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix r2c: <http://example.org/reg2chain/olive-oil#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

r2c:Acidity a owl:Class ;
    rdfs:label "Acidity (%)"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:BlendOfOliveOilsNotOfEuropeanUnionOrigin a owl:Class ;
    rdfs:label "‘blend of olive oils not of European Union origin’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:BlendOfOliveOilsOfEuropeanUnionOrigin a owl:Class ;
    rdfs:label "‘blend of olive oils of European Union origin’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:BlendOfOliveOilsOfEuropeanUnionOriginAndNotOfEuropeanUnionOrigin a owl:Class ;
    rdfs:label "‘blend of olive oils of European Union origin and not of European Union origin’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:BlendsOfOliveOils a owl:Class ;
    rdfs:label "blends of olive oils"@en ;
    rdfs:subClassOf r2c:OliveOils .

r2c:CategoryOfOil a owl:Class ;
    rdfs:label "oil category information"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:ConsumptionInRestaurantsHospitalsCanteensAndOtherSimilarCollectiveEstablishments a owl:Class ;
    rdfs:label "consumption in restaurants, hospitals, canteens and other similar collective establishments"@en ;
    rdfs:subClassOf r2c:Process .

r2c:CrudeOlivePomaceOil a owl:Class ;
    rdfs:label "crude olive-pomace oil"@en ;
    r2c:refersTo r2c:Ref_PartVIIIPoint4OfAnnexVIIToRegulationEUNo,
        r2c:Ref_Point6OfTablesAAndBOfAnnexIToThisRegulat ;
    rdfs:subClassOf r2c:OlivePomaceOils .

r2c:ExtraVirginOliveOilObtainedInTheUnionOrTheNameOfTheMemberStateOrThirdCountryConcernedFromOlivesHarvestedInTheUnionOrTheNameOfTheMemberStateOrThirdCountryConcerned a owl:Class ;
    rdfs:label "‘(extra) virgin olive oil obtained in (the Union or the name of the Member State or third country concerned) from olives harvested in (the Union or the name of the Member State or third country concerned)’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:FattyAcidEthylEstersMgKg a owl:Class ;
    rdfs:label "Fatty acid ethyl esters (mg/kg)"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:FinalConsumer a owl:Class ;
    rdfs:label "final consumer"@en ;
    rdfs:subClassOf r2c:Actor .

r2c:FirstMechanicalPressing a owl:Class ;
    rdfs:label "first mechanical pressing"@en ;
    rdfs:subClassOf r2c:Process .

r2c:FruityMedianMf a owl:Class ;
    rdfs:label "Fruity median (Mf)"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:InternalConsumption a owl:Class ;
    rdfs:label "domestic consumption"@en ;
    rdfs:subClassOf r2c:Process .

r2c:K232 a owl:Class ;
    rdfs:label "K232"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:K268OrK270 a owl:Class ;
    rdfs:label "K268 or K270"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:LabellingOfParticulars a owl:Class ;
    rdfs:label "labelling"@en ;
    r2c:refersTo r2c:Ref_Articles1011And12,
        r2c:Ref_Articles6To9 ;
    rdfs:subClassOf r2c:Process .

r2c:ListOfIngredients a owl:Class ;
    rdfs:label "list of ingredients"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:Marketing a owl:Class ;
    rdfs:label "marketing"@en ;
    rdfs:subClassOf r2c:Process .

r2c:MaximumValuesForPeroxideWaxContentAndUltravioletAbsorption a owl:Class ;
    rdfs:label "maximum values for peroxide, wax content and ultraviolet absorption"@en ;
    r2c:refersTo r2c:Ref_CommissionImplementingRegulationEU202221 ;
    rdfs:subClassOf r2c:LabelItem .

r2c:MedianOfDefectMd a owl:Class ;
    rdfs:label "Median of defect (Md)"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:MemberStates a owl:Class ;
    rdfs:label "Member State"@en ;
    rdfs:subClassOf r2c:Actor .

r2c:NameOfTheFood a owl:Class ;
    rdfs:label "name of the food"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:NamesOfBrandsOrFirms a owl:Class ;
    rdfs:label "names of brands or firms"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:OilComprisingExclusivelyOilsObtainedByProcessingOlivePomaceAndOilsObtainedDirectlyFromOlives a owl:Class ;
    rdfs:label "‘oil comprising exclusively oils obtained by processing olive pomace and oils obtained directly from olives’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:OilComprisingExclusivelyOilsObtainedByTreatingTheProductObtainedAfterTheExtractionOfOliveOilAndOilsObtainedDirectlyFromOlives a owl:Class ;
    rdfs:label "‘oil comprising exclusively oils obtained by treating the product obtained after the extraction of olive oil and oils obtained directly from olives’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:OlivesWereHarvested a owl:Class ;
    rdfs:label "olive harvesting"@en ;
    rdfs:subClassOf r2c:Process .

r2c:PercentageOfFats a owl:Class ;
    rdfs:label "‘percentage of fats’"@en ;
    rdfs:subClassOf r2c:LabelItem .

r2c:PercolationOrCentrifugationOfTheOlivePaste a owl:Class ;
    rdfs:label "percolation or centrifugation of the olive paste"@en ;
    rdfs:subClassOf r2c:Process .

r2c:PeroxideValueMEqO2Kg a owl:Class ;
    rdfs:label "Peroxide value (mEq O2/kg)"@en ;
    rdfs:subClassOf r2c:QualityParameter .

r2c:Production a owl:Class ;
    rdfs:label "production"@en ;
    rdfs:subClassOf r2c:Process .

r2c:ProtectedDesignationOfOrigin a owl:Class ;
    rdfs:label "protected designation of origin"@en ;
    rdfs:subClassOf r2c:PlaceOfOrigin .

r2c:ProtectedGeographicalIndication a owl:Class ;
    rdfs:label "protected geographical indication"@en ;
    rdfs:subClassOf r2c:PlaceOfOrigin .

r2c:R002 a r2c:Permission ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:BlendsOfOliveOilAndOtherVegetableOils ;
    r2c:sourceProvision "Article 3(1)" .

r2c:R003 a r2c:Permission ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:Foodstuff ;
    r2c:sourceProvision "Article 3(2)" .

r2c:R005 a r2c:Obligation ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:MandatoryLabellingParticulars ;
    r2c:sourceProvision "Article 5(1)" .

r2c:R006 a r2c:Permission ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:VoluntaryLabellingParticulars ;
    r2c:sourceProvision "Article 5(3)" .

r2c:R007 a r2c:Obligation ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:InformationOnTheSpecialStorageConditions ;
    r2c:onParameter "namely that they must be stored away from light and heat" ;
    r2c:sourceProvision "Article 7" .

r2c:R008 a r2c:Obligation ;
    r2c:appliesTo r2c:ExtraVirginOliveOil ;
    r2c:concerns r2c:PlaceOfOrigin ;
    r2c:sourceProvision "Article 8(1)" .

r2c:R009 a r2c:Prohibition ;
    r2c:appliesTo r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil ;
    r2c:concerns r2c:PlaceOfOrigin ;
    r2c:sourceProvision "Article 8(2)" .

r2c:R011 a r2c:Obligation ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:AlphanumericIdentificationOfThePackagingPlant ;
    r2c:sourceProvision "Article 9" .

r2c:R012 a r2c:Permission ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:OptionalReservedTerms ;
    r2c:sourceProvision "Article 10" .

r2c:R013 a r2c:Permission ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:IndicationsOfOrganolepticCharacteristicsReferringToTasteOrSmell ;
    r2c:sourceProvision "Article 10, point (c)" .

r2c:R014 a r2c:Condition ;
    r2c:appliesTo r2c:IndicationOfTheMaximumAcidityExpectedByTheDateOfMinimumDurability ;
    r2c:concerns r2c:Condition_AcidityDeclaration ;
    r2c:conditionExpression "Peroxide, wax and UV maxima expected at the same minimum-durability date; same marking size and visual field; determined under Regulation (EU) 2022/2105." ;
    r2c:sourceProvision "Article 10, point (d)" ;
    r2c:thresholdValue "Peroxide, wax and UV maxima expected at the same minimum-durability date; same marking size and visual field; determined under Regulation (EU) 2022/2105."^^xsd:string .

r2c:R015 a r2c:Permission ;
    r2c:appliesTo r2c:ExtraVirginOliveOil ;
    r2c:concerns r2c:HarvestingYear ;
    r2c:sourceProvision "Article 11(1)" .

r2c:R016 a r2c:Permission ;
    r2c:appliesTo r2c:VirginOliveOil ;
    r2c:concerns r2c:HarvestingYear ;
    r2c:sourceProvision "Article 11(1)" .

r2c:R018 a r2c:Permission ;
    r2c:appliesTo r2c:BlendsOfOliveOilAndOtherVegetableOils ;
    r2c:concerns r2c:ImagesOrGraphics ;
    r2c:sourceProvision "Article 12(2)" .

r2c:R019 a r2c:Condition ;
    r2c:appliesTo r2c:ImagesOrGraphics ;
    r2c:concerns r2c:Condition_ImagesOnBlend ;
    r2c:conditionExpression "Article 1(b) oil content in the blend > 50%" ;
    r2c:sourceProvision "Article 12(2)" ;
    r2c:thresholdValue "Article 1(b) oil content in the blend > 50%"^^xsd:string .

r2c:R021 a r2c:Obligation ;
    r2c:appliesTo r2c:Foodstuff ;
    r2c:concerns r2c:PercentageOfOilRelativeToTheTotalNetWeightOfTheFoodstuff ;
    r2c:sourceProvision "Article 12(3)" .

r2c:R022 a r2c:Permission ;
    r2c:appliesTo r2c:Foodstuff ;
    r2c:concerns r2c:PercentageOfAddedOils ;
    r2c:sourceProvision "Article 12(4)" ;
    r2c:thresholdValue "100 × added Article 1(b) oil weight / total fat weight"^^xsd:string .

r2c:R023 a r2c:Obligation ;
    r2c:appliesTo r2c:BlendsOfOliveOilAndOtherVegetableOils,
        r2c:Foodstuff ;
    r2c:concerns r2c:OlivePomaceOil2 ;
    r2c:sourceProvision "Article 12(5)" .

r2c:R024 a r2c:QualityLimit ;
    r2c:appliesTo r2c:ExtraVirginOliveOil ;
    r2c:onParameter "Acidity (%)" ;
    r2c:sourceProvision "Annex I, Table A, row 1" ;
    r2c:thresholdNumeric "0,80" ;
    r2c:thresholdOperator "≤" ;
    r2c:thresholdUnit "%" ;
    r2c:thresholdValue "≤ 0,80"^^xsd:string .

