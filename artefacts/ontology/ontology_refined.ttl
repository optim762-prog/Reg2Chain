    r2c:appliesTo r2c:VirginOliveOil ;
    r2c:concerns r2c:PlaceOfOrigin ;
    r2c:onParameter "On the label." ;
    r2c:sourceProvision "Article 8(1)" .

r2c:R059 a r2c:QualityLimit ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:Threshold_PackagingCapacity ;
    r2c:onParameter "Packaging capacity in litres for sale to the final consumer; Article 4(2) permits a Member State exception for specified collective establishments." ;
    r2c:sourceProvision "Article 4(1)" ;
    r2c:thresholdNumeric "5,00" ;
    r2c:thresholdOperator "≤" ;
    r2c:thresholdUnit "L" ;
    r2c:thresholdValue "≤ 5"^^xsd:string .

r2c:R060 a r2c:Obligation ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:NonResealableOpeningSystem ;
    r2c:onParameter "Opening system cannot be sealed again after first opening." ;
    r2c:sourceProvision "Article 4(1)" .

r2c:R061 a r2c:Condition ;
    r2c:appliesTo r2c:LegalName ;
    r2c:concerns r2c:Condition_PrincipalField ;
    r2c:conditionExpression "Group legal name and, where required, origin in the principal field of vision on the same container; full particulars in homogeneous text." ;
    r2c:onParameter "Group legal name and, where required, origin in the principal field of vision on the same container; full particulars in homogeneous text." ;
    r2c:sourceProvision "Article 5(2)" .

r2c:R062 a r2c:Obligation ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils,
        r2c:OlivePomaceOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:LegalName ;
    r2c:onParameter "Use the description of the applicable oil category as its legal name." ;
    r2c:sourceProvision "Article 6(1), read with Article 5(1)" .

r2c:R063 a r2c:Obligation ;
    r2c:appliesTo r2c:ExtraVirginOliveOil ;
    r2c:concerns r2c:SuperiorCategoryOliveOilObtainedDirectlyFromOlivesAndSolelyByMechanicalMeans ;
    r2c:onParameter "Category information additional to the legal name, in clear indelible marking; it need not be adjacent to the legal name." ;
    r2c:sourceProvision "Article 6(2)(a)" .

r2c:R064 a r2c:Obligation ;
    r2c:appliesTo r2c:VirginOliveOil ;
    r2c:concerns r2c:OliveOilObtainedDirectlyFromOlivesAndSolelyByMechanicalMeans ;
    r2c:onParameter "Category information additional to the legal name, in clear indelible marking; it need not be adjacent to the legal name." ;
    r2c:sourceProvision "Article 6(2)(b)" .

r2c:R065 a r2c:Obligation ;
    r2c:appliesTo r2c:OliveOilComposedOfRefinedOliveOilsAndVirginOliveOils ;
    r2c:concerns r2c:OilComprisingExclusivelyOliveOilsThatHaveUndergoneRefiningAndOilsObtainedDirectlyFromOlives ;
    r2c:onParameter "Category information additional to the legal name, in clear indelible marking; it need not be adjacent to the legal name." ;
    r2c:sourceProvision "Article 6(2)(c)" .

r2c:R066 a r2c:Obligation ;
    r2c:appliesTo r2c:OlivePomaceOil ;
    r2c:concerns r2c:OlivePomaceCategoryInformation ;
    r2c:onParameter "Use either alternative wording in Article 6(2)(d)(i) or (ii), not both cumulatively; clear indelible marking, additional to the legal name." ;
    r2c:sourceProvision "Article 6(2)(d)" .

r2c:R067 a r2c:Condition ;
    r2c:appliesTo r2c:PlaceOfOrigin ;
    r2c:concerns r2c:Condition_OriginOptions ;
    r2c:conditionExpression "For eligible virgin grades: one permitted single-origin reference, the appropriate blend-origin declaration, or an applicable PDO/PGI." ;
    r2c:onParameter "For eligible virgin grades: one permitted single-origin reference, the appropriate blend-origin declaration, or an applicable PDO/PGI." ;
    r2c:sourceProvision "Article 8(3)" .

r2c:R068 a r2c:Condition ;
    r2c:appliesTo r2c:PlaceOfOrigin ;
    r2c:concerns r2c:Condition_ImportedOrigin ;
    r2c:conditionExpression "For imports from a third country, determine origin under Articles 59–63 of Regulation (EU) No 952/2013." ;
    r2c:onParameter "For imports from a third country, determine origin under Articles 59–63 of Regulation (EU) No 952/2013." ;
    r2c:sourceProvision "Article 8(5)" .

r2c:R069 a r2c:Condition ;
    r2c:appliesTo r2c:PlaceOfOrigin ;
    r2c:concerns r2c:Condition_HarvestExtractionOrigin ;
    r2c:conditionExpression "A Member State or Union origin designation corresponds to the area of both olive harvesting and the extraction mill; apply Article 8(7) when they differ." ;
    r2c:onParameter "A Member State or Union origin designation corresponds to the area of both olive harvesting and the extraction mill; apply Article 8(7) when they differ." ;
    r2c:sourceProvision "Article 8(6)" .

r2c:R070 a r2c:Condition ;
    r2c:appliesTo r2c:PlaceOfOrigin ;
    r2c:concerns r2c:Condition_DifferentHarvestExtractionCountries ;
    r2c:conditionExpression "If harvesting and extraction take place in different Member States or third countries, use the prescribed wording identifying both." ;
    r2c:onParameter "If harvesting and extraction take place in different Member States or third countries, use the prescribed wording identifying both." ;
    r2c:sourceProvision "Article 8(7)" .

r2c:R071 a r2c:Permission ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:FirstColdPressing ;
    r2c:onParameter "Only for first mechanical pressing below 27°C by a traditional extraction system using hydraulic presses." ;
    r2c:sourceProvision "Article 10(a)" .

r2c:R072 a r2c:Permission ;
    r2c:appliesTo r2c:ExtraVirginOliveOil,
        r2c:VirginOliveOil ;
    r2c:concerns r2c:ColdExtraction ;
    r2c:onParameter "Only for oil obtained below 27°C by percolation or centrifugation of the olive paste." ;
    r2c:sourceProvision "Article 10(b)" .

r2c:R073 a r2c:Condition ;
    r2c:appliesTo r2c:HarvestingYear ;
    r2c:concerns r2c:Condition_SingleHarvest ;
    r2c:conditionExpression "100% of the container contents must come from that harvest. Apply to R015 and R016." ;
    r2c:onParameter "100% of the container contents must come from that harvest. Apply to R015 and R016." ;
    r2c:sourceProvision "Article 11(2)" .

r2c:R074 a r2c:Condition ;
    r2c:appliesTo r2c:HarvestingYear ;
    r2c:concerns r2c:Condition_HarvestDateFormat ;
    r2c:conditionExpression "Use the relevant marketing year or month then year of harvest; the month is the oil-extraction month." ;
    r2c:onParameter "Use the relevant marketing year or month then year of harvest; the month is the oil-extraction month." ;
    r2c:sourceProvision "Article 11(2)" .

r2c:R075 a r2c:Obligation ;
    r2c:appliesTo r2c:BlendsOfOliveOilAndOtherVegetableOils ;
    r2c:concerns r2c:BlendOfVegetableOilsOrTheSpecificNamesOfTheVegetableOilsConcernedAndOliveOil ;
    r2c:onParameter "Triggered when eligible oil is highlighted outside the ingredients list by words, images or graphics." ;
    r2c:sourceProvision "Article 12(1)" .

r2c:R076 a r2c:Obligation ;
    r2c:appliesTo r2c:BlendsOfOliveOilAndOtherVegetableOils ;
    r2c:concerns r2c:PercentageOfSuchOilsInTheBlend ;
    r2c:onParameter "Under the same trigger as Article 12(1), put the percentage directly after the trade description." ;
    r2c:sourceProvision "Article 12(1)" .

r2c:R077 a r2c:Permission ;
    r2c:appliesTo r2c:BlendsOfOliveOilAndOtherVegetableOils,
        r2c:Foodstuff ;
    r2c:concerns r2c:OliveOil ;
    r2c:onParameter "For Article 12(1) and (3) products, category descriptions may be shortened to olive oil; if olive-pomace oil is present, apply corrected R023 instead." ;
    r2c:sourceProvision "Article 12(5), first sentence" .

r2c:R078 a r2c:Prohibition ;
    r2c:appliesTo r2c:Foodstuff ;
    r2c:concerns r2c:LegalName ;
    r2c:onParameter "When other foodstuffs are added to an Article 1(b) oil, the resulting food must not bear an Article 6 oil-category legal name." ;
    r2c:sourceProvision "Article 12(6)" .

